{
  "name": "underfoot",
  "private": true,
  "version": "0.1.0",
  "description": "Installable web app that shows the geology beneath your feet, with a source badge (map, scale, citation) on every result.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/bundle-api-for-vercel.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "node scripts/sync-maplibre-worker.mjs"
  },
  "dependencies": {
    "@vis.gl/react-maplibre": "^8.1.2",
    "maplibre-gl": "^6.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.6"
  }
}
